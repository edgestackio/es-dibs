{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/edgestackio/es-dibs/main/registry/taxonomy.schema.json",
  "title": "ES-DIBs Taxonomy",
  "description": "JSON Schema for the es-dibs industry taxonomy file.",
  "type": "object",
  "required": ["version", "industries"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "updated": { "type": "string" },
    "maintainer": { "type": "string" },
    "description": { "type": "string" },
    "industries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "code", "name", "description", "sub_industries"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "code": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "sub_industries": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "code", "name", "description", "device_types"],
              "properties": {
                "id": { "type": "integer", "minimum": 1 },
                "code": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                "name": { "type": "string" },
                "description": { "type": "string" },
                "device_types": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "code", "name", "dib_id", "description", "tags"],
                    "properties": {
                      "id": { "type": "integer", "minimum": 1 },
                      "code": { "type": "string", "pattern": "^[a-z0-9-]+$" },
                      "name": { "type": "string" },
                      "dib_id": {
                        "type": "string",
                        "pattern": "^\\d+\\.\\d+\\.\\d+$",
                        "description": "Dot-notation taxonomy ID: {industry}.{sub_industry}.{device_type}"
                      },
                      "description": { "type": "string" },
                      "tags": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "required": ["id", "code", "name", "canonical_name", "standard_unit", "data_type", "dib_tag_id", "is_required"],
                          "properties": {
                            "id": { "type": "integer", "minimum": 1 },
                            "code": { "type": "string", "pattern": "^[a-z0-9_]+$" },
                            "name": { "type": "string" },
                            "canonical_name": { "type": "string", "pattern": "^[a-z0-9_.]+$" },
                            "standard_unit": { "type": "string" },
                            "data_type": {
                              "type": "string",
                              "enum": ["Double", "Float", "Int32", "Int64", "Boolean", "String"]
                            },
                            "dib_tag_id": {
                              "type": "string",
                              "pattern": "^\\d+\\.\\d+\\.\\d+\\.\\d+$",
                              "description": "Dot-notation tag ID: {industry}.{sub_industry}.{device_type}.{tag}"
                            },
                            "description": { "type": "string" },
                            "is_required": { "type": "boolean" }
                          },
                          "additionalProperties": false
                        }
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
